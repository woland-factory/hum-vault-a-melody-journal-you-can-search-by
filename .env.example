# Hum Vault runtime configuration.
# These are client-side identifiers, not credentials. They are read from the
# environment at container start and written into /env.js. Leave any of them
# blank to turn that integration off. Copy this file to .env for local use.

# Error tracking (GlitchTip / Sentry-compatible) DSN. Blank disables Sentry.
SENTRY_DSN=

# Umami analytics website id and script URL. Both must be set to load Umami.
UMAMI_WEBSITE_ID=
UMAMI_URL=

# Demo seed. Set to 1 or true to plant a small sample songbook on first boot,
# so a visitor can hear playback and run a hum search without a microphone.
# Clear the samples anytime from Settings. Leave blank to keep the vault empty.
SEED_DEMO=
